{
  "sourceLanguage": "en",
  "strings": {
    "%@ from %@": {
      "comment": "Second line, rain that lasts as far as the forecast reaches: Drizzle from 01:20",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vanaf %2$@"
          }
        }
      }
    },
    "%@, from %@": {
      "comment": "Face, second line with Apple's data once it is 20 minutes old: Apple Weather, from 23:40",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, van %2$@"
          }
        }
      }
    },
    "%@, hourly": {
      "comment": "Face, second line with Apple's hourly data: Apple Weather, hourly",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, per uur"
          }
        }
      }
    },
    "%lld min ago": {
      "comment": "Radar, a frame in the past",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min geleden"
          }
        }
      }
    },
    "%lld+ min": {
      "comment": "How far a short forecast reaches, in a headline",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld+ min"
          }
        }
      }
    },
    "1+ hours": {
      "comment": "How far the forecast reaches, in a headline",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1+ uur"
          }
        }
      }
    },
    "2+ hours": {
      "comment": "How far the forecast reaches, in a headline",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2+ uur"
          }
        }
      }
    },
    "About": {
      "comment": "Button and page title: privacy policy and the data's terms",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Info"
          }
        }
      }
    },
    "Allow it in Settings.": {
      "comment": "Under Location Off",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta dit toe in Instellingen."
          }
        }
      }
    },
    "Change Place": {
      "comment": "Button at the end of a picked place's forecast",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig plaats"
          }
        }
      }
    },
    "Changed by %@ into rain or dry, in five-minute or hourly steps.": {
      "comment": "About page, under Apple's Weather mark; %@ is the app's name",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door %@ omgezet in regen of droog, per vijf minuten of per uur."
          }
        }
      }
    },
    "Choose a Place": {
      "comment": "Button",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een plaats"
          }
        }
      }
    },
    "Continue": {
      "comment": "First launch button",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga door"
          }
        }
      }
    },
    "Couldn’t update": {
      "comment": "Second line in the app after a refresh failed",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijwerken mislukt"
