{
  "sourceLanguage": "en",
  "strings": {
    "%@ from %@": {
      "comment": "Second line, rain that lasts as far as the forecast reaches: Drizzle from 01:20",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vanaf %2$@"
          }
        }
      }
    },
    "%@, hourly": {
      "comment": "Face, second line with Apple's hourly data: Apple Weather, hourly",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, per uur"
          }
        }
      }
    },
    "%@, made %@": {
      "comment": "Face, second line with Apple's data once it is 20 minutes old: Weather, made 23:40",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, van %2$@"
          }
        }
      }
    },
    "%lld min ago": {
      "comment": "Radar, a frame in the past",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min geleden"
          }
        }
      }
    },
    "About": {
      "comment": "Button and page title: privacy policy and the data's terms",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Info"
          }
        }
      }
    },
    "Change Place": {
      "comment": "Button at the end of a picked place's forecast",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig plaats"
          }
        }
      }
    },
    "Changed by %@ into rain or dry, in five-minute or hourly steps.": {
      "comment": "About page, under Apple's Weather mark; %@ is the app's name",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door %@ omgezet in regen of droog, per vijf minuten of per uur."
          }
        }
      }
    },
    "Choose a Place": {
      "comment": "Button",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een plaats"
          }
        }
      }
    },
    "Continue": {
      "comment": "First launch button",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga door"
          }
        }
      }
    },
    "Couldn’t update": {
      "comment": "Second line in the app after a refresh failed",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijwerken mislukt"
          }
        }
      }
    },
    "DATA": {
      "comment": "Circle without a forecast, second line",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DATA"
          }
        }
      }
    },
    "Drizzle": {
      "comment": "How hard, second line",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motregen"
          }
        }
      }
    },
    "Dry": {
      "comment": "The circle with no rain forecast, and the second line: Dry 00:25–01:20",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Droog"
          }
        }
      }
    },
    "Dry for %@": {
      "comment": "Headline, no rain as far as the forecast reaches: Dry for over an hour",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ droog"
          }
        }
      }
    },
    "Dry for %lld min": {
      "comment": "Headline, rain starts within the hour",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog %lld min droog"
          }
        }
      }
    },
    "Dry from %@": {
      "comment": "Second line, dry as far as the forecast reaches",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Droog vanaf %@"
          }
        }
      }
    },
    "Dry until %@": {
      "comment": "Headline, dry for an hour or more: Dry until 15:10",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Droog tot %@"
          }
        }
      }
    },
    "FOR": {
      "comment": "Circle, above the number, raining now: rain FOR 14 MIN more",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NOG"
          }
        }
      }
    },
    "Forecast Unavailable": {
      "comment": "Problem title",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen verwachting"
          }
        }
      }
    },
    "Forecast made %@": {
      "comment": "Second line once the forecast is 20 minutes old: when it was made",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwachting van %@"
          }
        }
      }
    },
    "HR": {
      "comment": "Circle, under the number, hourly forecast: <1 HR",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "UUR"
          }
        }
      }
    },
    "HRS": {
      "comment": "Circle, under the number: 1+ HRS",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "UUR"
          }
        }
      }
    },
    "Heaviest around %@": {
      "comment": "Second line while it rains for an hour or more",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het hardst rond %@"
          }
        }
      }
    },
    "Heavy": {
      "comment": "Scale line in the app's graph",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwaar"
          }
        }
      }
    },
    "Heavy rain": {
      "comment": "How hard, second line",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zware regen"
          }
        }
      }
    },
    "Hourly forecast": {
      "comment": "Second line, where Apple has only an hourly forecast",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwachting per uur"
          }
        }
      }
    },
    "Hourly forecast made %@": {
      "comment": "Second line of an hourly forecast once it is 20 minutes old: when it was made",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwachting per uur van %@"
          }
        }
      }
    },
    "IN": {
      "comment": "Circle, above the number, dry now: rain IN 39 MIN",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OVER"
          }
        }
      }
    },
    "KNMI forecast made %@": {
      "comment": "Credit under the app's graph: whose forecast, and when it was made",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KNMI-verwachting %@"
          }
        }
      }
    },
    "Last forecast %@": {
      "comment": "Under No Recent Forecast, and on the face",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatste verwachting %@"
          }
        }
      }
    },
    "Legal": {
      "comment": "Apple Weather's legal link",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Juridisch"
          }
        }
      }
    },
    "Light": {
      "comment": "Scale line in the app's graph",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht"
          }
        }
      }
    },
    "Light rain": {
      "comment": "How hard, second line",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichte regen"
          }
        }
      }
    },
    "Location Not Found": {
      "comment": "Problem title",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie niet gevonden"
          }
        }
      }
    },
    "Location Not Set": {
      "comment": "Problem title",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie niet ingesteld"
          }
        }
      }
    },
    "Location Off": {
      "comment": "Problem title",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie uit"
          }
        }
      }
    },
    "MIN": {
      "comment": "Circle, under the number",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "MIN"
          }
        }
      }
    },
    "My Location": {
      "comment": "Title of the forecast for where the wearer is, beside the location arrow",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn locatie"
          }
        }
      }
    },
    "No": {
      "comment": "Circle without a forecast, first line: No PLACE, No DATA",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen"
          }
        }
      }
    },
    "No Forecast Here": {
      "comment": "Problem title",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier geen verwachting"
          }
        }
      }
    },
    "No Recent Forecast": {
      "comment": "Problem title, forecast over an hour old",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwachting te oud"
          }
        }
      }
    },
    "No places found": {
      "comment": "Place search with no results",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen plaatsen gevonden"
          }
        }
      }
    },
    "Now": {
      "comment": "Start of the time axis, and the radar's present frame",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu"
          }
        }
      }
    },
    "Open Settings, then Privacy & Security > Location Services > %@ > While Using the App.": {
      "comment": "Under Location Off: the way to turn location on, in watchOS's own words (Settings on the watch, watchOS 27). watchOS lets no app open Settings; %@ is the app's name",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instellingen, dan Privacy en beveiliging > Locatievoorzieningen > %@ > Bij gebruik van app."
          }
        }
      }
    },
    "PLACE": {
      "comment": "Circle without a place, second line",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PLEK"
          }
        }
      }
    },
    "Pause": {
      "comment": "Radar button, for VoiceOver",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeer"
          }
        }
      }
    },
    "Permission Expired": {
      "comment": "Problem title: Allow Once has run out, so the system must ask again",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toestemming verlopen"
          }
        }
      }
    },
    "Place": {
      "comment": "Title of the place search",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaats"
          }
        }
      }
    },
    "Play": {
      "comment": "Radar button, for VoiceOver",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel af"
          }
        }
      }
    },
    "Privacy Policy": {
      "comment": "Link on the About page",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacybeleid"
          }
        }
      }
    },
    "Radar": {
      "comment": "Button and page title",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Radar"
          }
        }
      }
    },
    "Radar Unavailable": {
      "comment": "Radar page when it can't load",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Radar niet beschikbaar"
          }
        }
      }
    },
    "Rain": {
      "comment": "How hard, second line: moderate rain",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regen"
          }
        }
      }
    },
    "Rain data from KNMI under CC BY 4.0, changed by %@.": {
      "comment": "About page, KNMI's licence; %@ is the app's name",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regendata van het KNMI onder CC BY 4.0, bewerkt door %@."
          }
        }
      }
    },
    "Rain for %@": {
      "comment": "Headline, rain as far as the forecast reaches: Rain for over an hour",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ regen"
          }
        }
      }
    },
    "Rain stops in %lld min": {
      "comment": "Headline, rain stops within the hour",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog %lld min regen"
          }
        }
      }
    },
    "Rain until %@": {
      "comment": "Headline, rain for an hour or more: Rain until 15:10",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regen tot %@"
          }
        }
      }
    },
    "Source: KNMI": {
      "comment": "Credit under an old forecast, and on the radar",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bron: KNMI"
          }
        }
      }
    },
    "Tap for steps": {
      "comment": "Face, second line of Location off: a tap opens the steps to turn location on",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik voor de stappen"
          }
        }
      }
    },
    "Tap to allow location": {
      "comment": "Face, second line of Permission expired",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om locatie toe te staan"
          }
        }
      }
    },
    "Tap to choose a place": {
      "comment": "Face, second line of a problem",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om een plaats te kiezen"
          }
        }
      }
    },
    "Tap to set up": {
      "comment": "Face, second line before the first launch",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om in te stellen"
          }
        }
      }
    },
    "Tap to try again": {
      "comment": "Face, second line of a problem",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om opnieuw te proberen"
          }
        }
      }
    },
    "To keep your watch face up to date, choose Allow While Using App.": {
      "comment": "Under Permission Expired, before the system's location question. The quoted words are watchOS's own button",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies ‘Bij gebruik van app’ om je wijzerplaat bij te houden."
          }
        }
      }
    },
    "To see the rain where you are, choose Allow While Using App.": {
      "comment": "First launch, before the system's location question. The quoted words are watchOS's own button",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies ‘Bij gebruik van app’ om de regen te zien waar je bent."
          }
        }
      }
    },
    "Town or postcode": {
      "comment": "Prompt in the place search field",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaats of postcode"
          }
        }
      }
    },
    "Try Again": {
      "comment": "Button",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer opnieuw"
          }
        }
      }
    },
    "Use My Location": {
      "comment": "Button in the place search",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik mijn locatie"
          }
        }
      }
    },
    "When the next rain starts or stops.": {
      "comment": "The widget's description when adding it to a face",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer de volgende bui begint of stopt."
          }
        }
      }
    },
    "Zoom in": {
      "comment": "Radar button",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom in"
          }
        }
      }
    },
    "Zoom out": {
      "comment": "Radar button",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom uit"
          }
        }
      }
    },
    "in %lld min": {
      "comment": "Radar, a frame in the future",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "over %lld min"
          }
        }
      }
    },
    "over %lld min": {
      "comment": "How far a short forecast reaches, ending a headline: Dry for over 50 min. Dutch starts the headline with it.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruim %lld min"
          }
        }
      }
    },
    "over 2 hours": {
      "comment": "How far the forecast reaches, ending a headline: Dry for over 2 hours. Dutch starts the headline with it.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruim 2 uur"
          }
        }
      }
    },
    "over an hour": {
      "comment": "How far the forecast reaches, ending a headline: Dry for over an hour. Dutch starts the headline with it.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruim een uur"
          }
        }
      }
    }
  },
  "version": "1.0"
}
