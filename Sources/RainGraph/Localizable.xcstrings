    "To see live rain data where you are, choose Allow While Using App.": {
      "comment": "First launch. The quoted words are watchOS's own Dutch button",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies ‘Sta toe bij gebruik van app’ voor live regendata waar je bent."
