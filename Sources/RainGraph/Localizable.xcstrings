    },
    "Rain for %@": {
      "comment": "Headline, rain as far as the forecast reaches: Rain for 1+ hours",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog %@ regen"
          }
        }
      }
    },
    "Rain for the next two hours.": {
      "comment": "The widget's description when adding it to a face",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regen in de komende twee uur."
          }
        }
